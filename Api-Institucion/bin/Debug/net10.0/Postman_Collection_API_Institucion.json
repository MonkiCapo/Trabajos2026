  ],
  "item": [
    {
      "name": "1. Cursos",
      "item": [
        {
          "name": "1.1 Consultar todos los cursos (Catálogo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cursos"]
            }
          }
        },
        {
          "name": "1.2 Consultar cursos abiertos con filtro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos?estado=Abierto",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cursos"],
              "query": [
                { "key": "estado", "value": "Abierto" }
              ]
            }
          }
        },
        {
          "name": "1.3 Consultar detalle de un curso por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cursos", "1"]
            }
          }
        },
        {
          "name": "1.4 Crear curso (Admin - RF5)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Programación Móvil con .NET MAUI\",\n  \"descripcion\": \"Desarrollo multiplataforma nativo.\",\n  \"cupoMaximo\": 25,\n  \"legajoDocente\": \"DOC-102\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cursos"]
            }
          }
        },
        {
          "name": "1.5 Asignar Docente a Curso (Admin - RF4)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"legajoDocente\": \"DOC-101\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cursos/2/docente",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cursos", "2", "docente"]
            }
          }
        },
        {
          "name": "1.6 Cambiar Estado del Curso (Abrir/Cerrar)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Cerrado\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cursos/1/estado",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cursos", "1", "estado"]
            }
          }
        },
        {
          "name": "1.7 Consultar alumnos inscriptos en un curso (Docente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/1/alumnos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cursos", "1", "alumnos"]
            }
          }
        }
      ]
