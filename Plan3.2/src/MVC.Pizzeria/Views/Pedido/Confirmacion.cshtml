@model MVC.Pizzeria.Models.ConfirmacionViewModel
@{
    ViewData["Title"] = "Confirmar Pedido";
}

<div class="mb-4 pb-2 border-bottom">
    <h1 class="fw-bold mb-0" style="color: var(--color-principal);">Confirmar Pedido 🍕</h1>
    <p class="text-muted mb-0">Revisá los datos de entrega y el detalle de tus pizzas antes de confirmar.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <strong>Hubo un problema al procesar el pedido:</strong>
        <ul class="mb-0 mt-2">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form method="post" asp-action="Confirmar" asp-controller="Pedido">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Nombre" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Telefono" />
    <input type="hidden" asp-for="Direccion" />

    <div class="row g-4">
        <!-- Datos del cliente autenticado -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="fs-3 me-2">📍</span>
                        <h4 class="fw-bold mb-0" style="color: var(--color-principal);">
                            Datos de entrega
                        </h4>
                    </div>
                    <p class="text-muted small">Tu pedido se registrará con la información de tu cuenta:</p>

                    <div class="bg-light p-3 rounded-3 mb-3 border">
                        <div class="mb-2 pb-2 border-bottom">
                            <span class="text-muted small d-block">Destinatario</span>
                            <span class="fw-bold fs-6">@Model.Nombre</span>
                        </div>
                        <div class="mb-2 pb-2 border-bottom">
                            <span class="text-muted small d-block">Correo electrónico</span>
                            <span class="fw-bold">@Model.Email</span>
                        </div>
                        <div class="mb-2 pb-2 border-bottom">
                            <span class="text-muted small d-block">Teléfono de contacto</span>
                            <span class="fw-bold">@Model.Telefono</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Dirección de entrega</span>
                            <span class="fw-bold text-success fs-6">@Model.Direccion</span>
                        </div>
                    </div>

                    <div class="alert alert-info py-2 small mb-0" role="alert">
                        ℹ️ <strong>Entrega a domicilio:</strong> El cadete llevará el pedido a la dirección indicada.
                    </div>
                </div>
            </div>
        </div>

        <!-- Detalle de pizzas -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="fs-3 me-2">🛒</span>
                        <h4 class="fw-bold mb-0" style="color: var(--color-principal);">
                            Tu pedido (@Model.Carrito.CantidadTotal pizzas)
                        </h4>
                    </div>

                    <div class="mb-3">
                        @foreach (var item in Model.Carrito.Items)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div>
                                    <span class="fw-bold text-dark">@item.Cantidad × @item.Nombre</span>
                                    <span class="text-muted small d-block">
                                        $@item.Precio.ToString("N2") c/u
                                    </span>
                                </div>
                                <span class="fw-bold fs-6">$@item.Subtotal.ToString("N2")</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="fs-5 fw-bold">Total a pagar:</span>
                        <span class="fs-4 fw-bold text-success">$@Model.Carrito.Total.ToString("N2")</span>
                    </div>

                    <a asp-action="Resumen" asp-controller="Pedido" class="btn btn-link px-0 mt-3 text-decoration-none">
                        ← Modificar pizzas del carrito
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de confirmación -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3 rounded-3 shadow-sm mt-4"
         style="background-color: var(--color-principal); color: white;">
        <div>
            <span class="d-block small text-uppercase" style="opacity: .85;">Total del pedido</span>
            <span class="fs-3 fw-bold">$@Model.Carrito.Total.ToString("N2")</span>
        </div>
        <button type="submit" class="btn btn-light btn-lg fw-bold px-4 shadow-sm">
            Confirmar pedido ✅
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
