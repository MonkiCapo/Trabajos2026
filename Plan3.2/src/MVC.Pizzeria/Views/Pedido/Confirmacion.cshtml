@model MVC.Pizzeria.Models.ConfirmacionViewModel
@{
    ViewData["Title"] = "Confirmar Pedido";
}

<div class="mb-4 pb-2 border-bottom">
    <h1 class="fw-bold mb-0" style="color: var(--color-principal);">Confirmar Pedido</h1>
    <p class="text-muted mb-0">Último paso: contanos a quién le hacemos el pedido.</p>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <strong>Revisá los datos:</strong>
        <ul class="mb-0 mt-2">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form method="post" asp-action="Confirmar" asp-controller="Pedido">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3" style="color: var(--color-principal);">
                        Datos del cliente
                    </h4>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label">Nombre y Apellido</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Ana Ruiz" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="ana@email.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" placeholder="+54 9 11 1234-5678" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Direccion" class="form-label">Dirección de entrega</label>
                            <input asp-for="Direccion" class="form-control" placeholder="Calle, número, piso" />
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>
                    </div>

                    <p class="text-muted small mb-0 mt-3">
                        Si el email ya está registrado, el pedido se suma a ese cliente.
                        No hace falta cuenta ni contraseña.
                    </p>
                </div>
            </div>
        </div>

        @* Solo lectura: el carrito viene de la sesion, este form no lo modifica. *@
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3" style="color: var(--color-principal);">
                        Tu pedido (@Model.Carrito.CantidadTotal)
                    </h4>

                    @foreach (var item in Model.Carrito.Items)
                    {
                        <div class="d-flex justify-content-between align-items-start py-2 border-bottom">
                            <span>
                                <span class="fw-semibold">@item.Cantidad ×</span>
                                @item.Nombre
                                <span class="text-muted small d-block">
                                    $@item.Precio.ToString("N2") c/u
                                </span>
                            </span>
                            <span class="fw-semibold">$@item.Subtotal.ToString("N2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center pt-3 mt-2">
                        <span class="fs-5 fw-bold">Total</span>
                        <span class="fs-4 fw-bold text-success">$@Model.Carrito.Total.ToString("N2")</span>
                    </div>

                    <a asp-action="Resumen" asp-controller="Pedido" class="btn btn-link px-0 mt-2">
                        ← Volver al carrito
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3 rounded shadow-sm mt-4"
         style="background-color: var(--color-principal); color: white;">
        <div>
            <span class="d-block small text-uppercase" style="opacity: .85;">Total del pedido</span>
            <span class="fs-3 fw-bold">$@Model.Carrito.Total.ToString("N2")</span>
        </div>
        <button type="submit" class="btn btn-light btn-lg fw-bold px-4">
            Confirmar pedido
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
