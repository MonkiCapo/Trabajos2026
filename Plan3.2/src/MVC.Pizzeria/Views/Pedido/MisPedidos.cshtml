@model MVC.Pizzeria.Models.MisPedidosViewModel
@using MVC.Pizzeria.Helpers
@{
    ViewData["Title"] = "Mis pedidos";
}

<div class="my-4">
    <h1 class="fw-bold mb-0" style="color: var(--color-principal);">Mis pedidos</h1>
    <p class="text-muted mb-0">Los pedidos que confirmaste desde este navegador.</p>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success" role="alert">@ok</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (!Model.HayPedidos)
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-5 text-center">
            <div class="mb-3" style="font-size: 3rem;">🧾</div>
            <p class="mb-1 fw-semibold">Todavía no tenés pedidos por acá.</p>
            <p class="text-muted mb-4">Cada pedido que confirmes queda anotado en esta lista.</p>
            <a asp-action="Productos" asp-controller="Home" class="btn btn-primary">Armar mi primer pedido</a>
        </div>
    </div>
}
else
{
    @foreach (var pedido in Model.Pedidos)
    {
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fs-5 fw-bold" style="color: var(--color-principal);">#@pedido.PedidoId</span>
                            <span class="badge @EstadoPedidoUI.BadgeDe(pedido.Estado)">@EstadoPedidoUI.NombreDe(pedido.Estado)</span>
                        </div>
                        <div class="text-muted small mb-2">
                            @pedido.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                        </div>
                        <div>@pedido.Items</div>
                        <div class="text-muted small">@pedido.CantidadPizzas @(pedido.CantidadPizzas == 1 ? "pizza" : "pizzas") · @pedido.Cliente</div>
                    </div>

                    <div class="text-end">
                        <div class="fs-5 fw-bold text-success mb-2">$@pedido.Total.ToString("N2")</div>
                        <a asp-action="Seguimiento" asp-route-id="@pedido.PedidoId" class="btn btn-sm btn-outline-primary">
                            Ver seguimiento
                        </a>
                    </div>
                </div>

                <hr class="my-3" />

                <form asp-action="OlvidarPedido" method="post" class="text-end">
                    <input type="hidden" name="id" value="@pedido.PedidoId" />
                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none">
                        Sacar de mi lista
                    </button>
                </form>
            </div>
        </div>
    }

    <div class="text-center mt-4">
        <a asp-action="Productos" asp-controller="Home" class="btn btn-outline-secondary">Volver al menú</a>
    </div>
}