@model PizzaAdminViewModel
@{
    ViewData["Title"] = "Nueva Pizza";
}

<div class="mb-4 pb-2 border-bottom">
    <h1 class="fw-bold mb-0" style="color: var(--color-principal);">Nueva Pizza 🍕</h1>
    <p class="text-muted mb-0">Cargá los datos de la pizza y opcionalmente una imagen.</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post" asp-action="Crear" enctype="multipart/form-data">
                    <partial name="_Formulario" model="Model" />

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-warning fw-bold px-4">Crear pizza</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
