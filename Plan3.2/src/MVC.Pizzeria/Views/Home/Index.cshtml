@{
    ViewData["Title"] = "Inicio";
}

<div class="hero-section text-center">
    <h1 class="hero-title">¡Las mejores PIZZAS solo en este lugar! 🍕</h1>
    <p class="hero-subtitle">
        Pizzas elaboradas artesanalmente con masa de fermentación lenta, ingredientes seleccionados y horneadas a la perfección.
    </p>
</div>

<div class="row g-4 my-4">
    <div class="col-md-4">
        <div class="feature-card text-center">
            <div class="feature-icon">🔥</div>
            <h4>Horno de Leña</h4>
            <p class="text-muted">Cocinadas a más de 400°C para lograr una masa crocante por fuera y suave por dentro.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card text-center">
            <div class="feature-icon">🌿</div>
            <h4>Ingredientes Frescos</h4>
            <p class="text-muted">Muzzarella 100% natural, salsa de tomates italianos y vegetales cosechados en el día.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card text-center">
            <div class="feature-icon">🚀</div>
            <h4>Envío Rápido</h4>
            <p class="text-muted">Tu pedido directo a tu puerta en minutos, caliente y listo para disfrutar.</p>
        </div>
    </div>
</div>
