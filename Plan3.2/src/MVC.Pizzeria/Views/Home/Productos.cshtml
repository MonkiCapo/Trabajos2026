@model List<MVC.Pizzeria.Models.PizzaViewModel>
@{
    ViewData["Title"] = "Nuestro Menú";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="fw-bold mb-0" style="color: var(--color-principal);">Nuestros Productos 🍕</h1>
        <p class="text-muted mb-0">Elegí tus pizzas y agregalas al carrito.</p>
    </div>
    <a asp-action="Resumen" asp-controller="Pedido" class="btn btn-pizza-primary">
        Ver mi carrito 🛒
    </a>
</div>

@if (ViewData["Error"] is string errorCatalogo)
{
    <div class="alert alert-danger" role="alert">@errorCatalogo</div>
}
@if (TempData["Ok"] is string okAgregar)
{
    <div class="alert alert-success" role="alert">@okAgregar</div>
}
@if (TempData["Error"] is string errorAgregar)
{
    <div class="alert alert-danger" role="alert">@errorAgregar</div>
}

@if (!Model.Any())
{
    <div class="text-center my-5">
        <p class="text-muted fs-5">No hay pizzas disponibles para mostrar.</p>
    </div>
}

<div class="row g-4">
    @foreach (var pizza in Model)
    {
        <div class="col-md-6 col-lg-3">
            <div class="product-card h-100 shadow-sm border rounded overflow-hidden">
                <div class="product-image-container" style="height: 200px; overflow: hidden;">
                    <img src="@pizza.ImagenUrl" class="w-100 h-100 object-fit-cover" alt="@pizza.Nombre"
                         onerror="this.src='/images/pizza-generica.jpg';" />
                </div>

                <div class="p-3 d-flex flex-column">
                    <div class="product-header d-flex justify-content-between align-items-center mb-2">
                        <h5 class="product-title mb-0 fw-bold">@pizza.Nombre</h5>
                        <span class="badge bg-secondary">@pizza.Tamanio</span>
                    </div>

                    <div class="product-body">
                        <div class="mb-3">
                            <span class="d-block text-muted small fw-bold mb-1">Ingredientes:</span>
                            @if (pizza.Ingredientes.Any())
                            {
                                foreach (var ing in pizza.Ingredientes)
                                {
                                    <span class="badge bg-light text-dark border me-1">@ing</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Sin detalle de ingredientes.</span>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="fw-bold text-success fs-5">$@pizza.Precio.ToString("N2")</span>
                        </div>

                        <div class="mt-auto">
                            @* Solo viaja el id de la pizza: el nombre y el precio
                               los vuelve a pedir PedidoController a la API. *@
                            <form method="post" asp-action="Agregar" asp-controller="Pedido">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="pizzaId" value="@pizza.Id" />
                                <div class="d-flex gap-2">
                                    <input type="number"
                                           name="cantidad"
                                           class="form-control cantidad-input"
                                           value="1"
                                           min="1"
                                           max="99"
                                           step="1"
                                           aria-label="Cantidad de @pizza.Nombre" />
                                    <button type="submit" class="btn btn-pizza-primary flex-grow-1">
                                        Agregar
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
