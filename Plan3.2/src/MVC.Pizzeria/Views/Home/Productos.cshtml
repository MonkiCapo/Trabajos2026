@model IEnumerable<MVC.Pizzeria.Models.PizzaViewModel>
@{
    ViewData["Title"] = "Nuestras Pizzas";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h1 class="fw-bold mb-0" style="color: var(--color-principal);">Nuestros Productos 🍕</h1>
        <p class="text-muted mb-0">Selección artesanal preparada con los mejores ingredientes.</p>
    </div>
    <span class="badge bg-danger fs-6 px-3 py-2">Menú Completo</span>
</div>

<div class="row g-4">
    @foreach (var pizza in Model)
    {
        <div class="col-md-6 col-lg-3">
            <div class="product-card">
                <div class="product-header d-flex justify-content-between align-items-center">
                    <h5 class="product-title">@pizza.Nombre</h5>
                    <span class="product-badge">@pizza.Tamanio</span>
                </div>
                <div class="product-body">
                    <p class="text-secondary small mb-3">@pizza.Descripcion</p>
                    
                    <div class="mb-3">
                        <span class="d-block text-muted small fw-bold mb-1">Ingredientes:</span>
                        @foreach (var ing in pizza.Ingredientes)
                        {
                            <span class="ingredient-badge">@ing</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
