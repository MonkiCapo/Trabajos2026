@model MVC.Pizzeria.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <div class="display-5 mb-2">🍕</div>
                    <h2 class="fw-bold mb-1" style="color: var(--color-principal);">Iniciar Sesión</h2>
                    <p class="text-muted small">Ingresá tus credenciales para continuar con tu pedido</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-warning py-2 small" role="alert">
                        @error
                    </div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small">Correo Electrónico</label>
                        <input asp-for="Email" class="form-control form-control-lg fs-6" placeholder="ejemplo@correo.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold small">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg fs-6" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-pizza-primary w-100 py-2 fs-6 shadow-sm">
                        Ingresar
                    </button>
                </form>

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="text-muted small mb-0">
                        ¿No tenés cuenta todavía?
                        <a asp-action="Registro" asp-controller="Auth" asp-route-returnUrl="@Model?.ReturnUrl" class="fw-bold text-decoration-none" style="color: var(--color-principal);">
                            Registrate acá
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
