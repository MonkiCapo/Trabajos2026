@model MVC.Pizzeria.Models.RegistroViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7 col-lg-6 col-xl-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-sm-5">
                <div class="text-center mb-4">
                    <div class="display-5 mb-2">📝</div>
                    <h2 class="fw-bold mb-1" style="color: var(--color-principal);">Crear Cuenta</h2>
                    <p class="text-muted small">Registrate para guardar tus datos y pedir tus pizzas favoritas</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <form asp-action="Registro" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold small">Nombre y Apellido</label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan Pérez" autofocus />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small">Correo Electrónico</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="juan@correo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="Telefono" class="form-label fw-semibold small">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" placeholder="+54 9 11 1234-5678" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Direccion" class="form-label fw-semibold small">Dirección de Entrega</label>
                            <input asp-for="Direccion" class="form-control" placeholder="Calle 123, Piso 4B" />
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-sm-6">
                            <label asp-for="Password" class="form-label fw-semibold small">Contraseña</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirmar Contraseña</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-pizza-primary w-100 py-2 fs-6 shadow-sm">
                        Registrarme
                    </button>
                </form>

                <div class="text-center mt-4 pt-2 border-top">
                    <p class="text-muted small mb-0">
                        ¿Ya tenés una cuenta?
                        <a asp-action="Login" asp-controller="Auth" asp-route-returnUrl="@Model?.ReturnUrl" class="fw-bold text-decoration-none" style="color: var(--color-principal);">
                            Iniciá sesión acá
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
