@model MVC.Pizzeria.Models.RegistroViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="max-w-md mx-auto my-12 p-8 bg-white dark:bg-zinc-800 rounded-2xl shadow-xl border border-zinc-200 dark:border-zinc-700">
    <h2 class="text-3xl font-extrabold text-center mb-6 text-zinc-900 dark:text-white">📝 Registrarse</h2>

    <form asp-action="Registro" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm font-semibold"></div>

        <div>
            <label asp-for="Nombre" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Nombre Completo</label>
            <input asp-for="Nombre" class="w-full px-4 py-2 border rounded-lg dark:bg-zinc-900 dark:border-zinc-700 dark:text-white" placeholder="Juan Pérez" />
            <span asp-validation-for="Nombre" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Email</label>
            <input asp-for="Email" class="w-full px-4 py-2 border rounded-lg dark:bg-zinc-900 dark:border-zinc-700 dark:text-white" placeholder="juan@correo.com" />
            <span asp-validation-for="Email" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label asp-for="Telefono" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Teléfono</label>
            <input asp-for="Telefono" class="w-full px-4 py-2 border rounded-lg dark:bg-zinc-900 dark:border-zinc-700 dark:text-white" placeholder="1123456789" />
            <span asp-validation-for="Telefono" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label asp-for="Direccion" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Dirección de Entrega</label>
            <input asp-for="Direccion" class="w-full px-4 py-2 border rounded-lg dark:bg-zinc-900 dark:border-zinc-700 dark:text-white" placeholder="Av. Corrientes 1234" />
            <span asp-validation-for="Direccion" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Contraseña</label>
            <input asp-for="Password" type="password" class="w-full px-4 py-2 border rounded-lg dark:bg-zinc-900 dark:border-zinc-700 dark:text-white" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1">Confirmar Contraseña</label>
            <input asp-for="ConfirmPassword" type="password" class="w-full px-4 py-2 border rounded-lg dark:bg-zinc-900 dark:border-zinc-700 dark:text-white" placeholder="••••••••" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500"></span>
        </div>

        <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-lg shadow-md transition duration-200">
            Crear Cuenta
        </button>
    </form>

    <p class="text-center text-sm text-zinc-600 dark:text-zinc-400 mt-6">
        ¿Ya tenés cuenta? 
        <a asp-action="Login" class="text-amber-500 font-semibold hover:underline">Iniciá sesión acá</a>
    </p>
</div>
